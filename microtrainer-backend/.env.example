# MicroTrainer Backend — copy to .env and fill in values

# Groq (required for AI features)
GROQ_API_KEY=gsk_your_key_here

# Google Sheets (required in production; optional in development — see index.js)
SHEET_ID=your_google_sheet_id

# Optional MongoDB (connects on startup when set; persistence is still file-based unless you wire services)
# MONGODB_URI=mongodb://127.0.0.1:27017/microtrainer

# Central platform sync (off unless PLATFORM_API_KEY is set; set CENTRAL_PLATFORM_ENABLED=false to force off)
# CENTRAL_PLATFORM_URL=http://localhost:6000
# PLATFORM_API_KEY=
# INSTITUTION_ID=
# CENTRAL_PLATFORM_ENABLED=true

# Official license/setup server. In the hybrid model this validates the license
# and receives lightweight sync heartbeats for trainer verification.
LICENSE_KEY=student@example.com:generated_license_hash
STUDENT_EMAIL=student@example.com
LICENSE_SERVER_URL=https://your-license-server.onrender.com
OFFICIAL_SYNC_REQUIRED=1
OFFICIAL_SYNC_STALE_HOURS=72

# Piston code runner — public API is whitelist-only; use local Docker instead:
#   docker compose -f docker-compose.piston.yml up -d
# Self-hosted (after: docker compose -f docker-compose.piston.yml up -d && node scripts/install-piston-packages.js)
PISTON_URL=http://127.0.0.1:2000/api/v2

# Local JS/Python fallback when Piston is unreachable (default: on in non-production)
# USE_LOCAL_CODE_FALLBACK=true

PORT=5000
NODE_ENV=development

# Frontend origin for Socket.io / CORS
FRONTEND_URL=http://localhost:5173

# Trainer emails (Google/GitHub OAuth) — comma-separated
TRAINER_EMAILS=saimahendra222@gmail.com,mahendra10kcoders@gmail.com

# Bug reports emailed here (defaults to TRAINER_EMAILS if unset)
BUG_REPORT_EMAIL=saimahendra222@gmail.com,mahendra10kcoders@gmail.com

# SendGrid — required for email delivery of bug reports
# SENDGRID_API_KEY=
# FROM_EMAIL=noreply@yourdomain.com

# JWT signing (OAuth sessions) — use a long random string
JWT_SECRET=change_me_to_another_long_random_secret

# Google OAuth (Console → APIs → Credentials → OAuth client ID, Web)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# GitHub OAuth (Settings → Developer settings → OAuth Apps)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Smoke test: npm test with live server check
# SMOKE_BASE_URL=http://127.0.0.1:5000
# SMOKE_STRICT=1
