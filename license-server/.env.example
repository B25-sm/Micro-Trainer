# License Server Configuration

# Server Port
PORT=3000

# Admin Key (for generating licenses and viewing list)
# Generate a strong random key: openssl rand -hex 32
ADMIN_KEY=your-super-secret-admin-key-here

# Node Environment
NODE_ENV=production

# Public URL of this deployed license/setup server
PUBLIC_BASE_URL=https://your-license-server.onrender.com

# Public GitHub repo used by Render one-click deploy
GITHUB_REPO_URL=https://github.com/yourusername/microtrainer

# Student setup magic-link expiry
SETUP_TOKEN_TTL_MINUTES=30

# SendGrid email delivery for setup links
SENDGRID_API_KEY=your_sendgrid_api_key_here
FROM_EMAIL=noreply@microtrainer.com
FROM_NAME=MicroTrainer

# Mark licenses disconnected if no sync heartbeat arrives
DISCONNECTED_AFTER_DAYS=3
